APP_ENV=local
APP_DEBUG=1
APP_TIMEZONE=Africa/Johannesburg
APP_URL=http://localhost:8000
# The frontend address(es) allowed to call the API, comma separated, e.g. https://your-frontend.example,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=grand_gala_gardens
DB_USER=root
DB_PASS=

JWT_SECRET=

# Enquiries, quotations, events and tickets (Mfundo's modules)
# Optional: also email new enquiries here (staff always see them on the Enquiries page)
STAFF_ENQUIRY_EMAIL=
FRONTEND_URL=http://localhost:5173
# How long an accepted quotation holds its dates while the guest pays, in hours (1 to 168, like STAY_HOLD_HOURS)
QUOTATION_HOLD_HOURS=72
# How long an unpaid ticket order holds its seats, in minutes
TICKET_HOLD_MINUTES=15
# Signs guest ticket links (X-Ticket-Access). At least 32 random characters, different in every environment.
TICKET_ACCESS_SECRET=

# Mailpit (BUILD_PLAN "Before we start": install it, so nobody emails a real guest by mistake).
# Its default SMTP port is 1025, with no login.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@grandgala.co.za
# On Railway: a real SMTP service instead (Brevo: MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, the SMTP login
# and SMTP key from Brevo's SMTP & API page). MAIL_FROM must be a sender Brevo has verified.
MAIL_USERNAME=
MAIL_PASSWORD=
# Railway's Hobby plan blocks SMTP ports: there, set a Brevo API key (SMTP & API -> API Keys) and email goes
# over HTTPS instead. Leave empty locally to keep using Mailpit.
BREVO_API_KEY=

# Password for every seeded demo account (staff and guests). Never put real passwords in the code.
# Leave empty and the demo accounts get random passwords nobody knows.
DEMO_ACCOUNT_PASSWORD=

# Where uploaded photos and videos are saved. Leave it as public/uploads so they are served as /uploads/...
# (a relative path counts from Grand_Gala_Backend). Tests point it at a temporary folder.
UPLOADS_DIR=public/uploads

# Stays, checkout and PayFast (Thabang's modules)
# How long an unpaid stay keeps its dates, in hours (1 to 168)
STAY_HOLD_HOURS=48
# Sandbox until the live account is checked. Merchant id and passphrase come from the PayFast dashboard.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
# PayFast's merchant key (sent in the payment form, so not secret). Sandbox test account: 10000100 / 46f0cd694581a
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# The addresses PayFast's notifications come from (single addresses or blocks like 197.97.145.144/28, comma separated).
# Empty refuses every notification. Check PayFast's current list before going live.
PAYFAST_VALID_IPS=
# PayFast's hostnames, looked up when a notification arrives (PayFast's advice: their addresses change)
PAYFAST_VALID_HOSTS=www.payfast.co.za,sandbox.payfast.co.za,w1w.payfast.co.za,w2w.payfast.co.za
# Optional. Return and cancel default to FRONTEND_URL + /payment/success and /payment/cancel;
# notify defaults to APP_URL + /api/payments/payfast/notify.
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
PAYFAST_NOTIFY_URL=
# Our own proxies (Railway), comma separated, e.g. 10.0.0.0/8. Only then is X-Forwarded-For believed.
TRUSTED_PROXY_CIDRS=
